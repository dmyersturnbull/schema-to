"""Runtime query helpers for the generated FastAPI application.

Generated by schema-to. Translates the list-operation query parameters
(``select``, ``where``, ``sort``, ``limit``, ``offset``) into parameterised
PostgreSQL queries built with ``psycopg.sql`` composition. This is
injection-safe: identifiers are quoted and every literal value is bound as a
parameter.

The ``where`` grammar (compiled to a SQL predicate)::

    expr       := or_expr
    or_expr    := and_expr ( "or" and_expr )*
    and_expr   := not_expr ( "and" not_expr )*
    not_expr   := "not" not_expr | atom
    atom       := "(" expr ")" | comparison
    comparison := path OP value
    OP         := "eq" | "ne" | "lt" | "le" | "gt" | "ge" | "in" | "like"
    path       := IDENT ( "." IDENT )*      # dotted: nested keys address JSON
    value      := number | string | "true" | "false" | "null"
                  | "[" value ( "," value )* "]"

A dotted ``path`` whose head names a JSON column addresses into the JSON value:
``meta.theme`` becomes ``"meta" #>> '{theme}'``.

Replace ``get_db`` with a real connection provider before serving traffic.
"""

from __future__ import annotations

import re
from collections.abc import AsyncIterator, Mapping, Sequence
from typing import Any

from psycopg import AsyncConnection, sql
from psycopg.rows import dict_row
from psycopg.types.json import Jsonb

__all__ = [
    "build_delete_query",
    "build_get_query",
    "build_list_query",
    "build_merge_patch_query",
    "build_replace_query",
    "dict_row",
    "get_db",
    "to_dict",
]


async def get_db() -> AsyncIterator[AsyncConnection]:
    """FastAPI dependency yielding a database connection.

    This is a stub. Replace it with a real provider, e.g. one backed by a
    ``psycopg_pool.AsyncConnectionPool``.
    """
    msg = "Configure get_db() with a psycopg AsyncConnection provider."
    raise NotImplementedError(msg)
    yield  # pragma: no cover - makes this an async generator


def to_dict(body: Any) -> dict[str, Any]:
    """Coerce a request body (Pydantic model or mapping) to a plain dict."""
    dump = getattr(body, "model_dump", None)
    if callable(dump):
        return dump(mode="json")
    return dict(body)


def _adapt(value: Any) -> Any:
    """Wrap JSON-shaped values so psycopg adapts them to ``jsonb``."""
    if isinstance(value, (dict, list)):
        return Jsonb(value)
    return value


class _Params:
    """Accumulates bound parameters and hands out named placeholders."""

    def __init__(self) -> None:
        self.values: dict[str, Any] = {}

    def add(self, value: Any) -> sql.Placeholder:
        name = f"p{len(self.values)}"
        self.values[name] = value
        return sql.Placeholder(name)


_OPS = {
    "eq": "=",
    "ne": "<>",
    "lt": "<",
    "le": "<=",
    "gt": ">",
    "ge": ">=",
    "like": "LIKE",
}


def _split_path(path: str) -> list[str]:
    return [p for p in path.split(".") if p]


def _column_ref(path: str, json_columns: frozenset[str], params: _Params) -> sql.Composable:
    """Build a column or JSON-extraction reference from a dotted path."""
    parts = _split_path(path)
    head = parts[0]
    if len(parts) == 1:
        return sql.Identifier(head)
    if head not in json_columns:
        msg = f"Cannot address into non-JSON column {head!r}."
        raise ValueError(msg)
    return sql.SQL("{} #>> {}").format(sql.Identifier(head), params.add(parts[1:]))


# ---------------------------------------------------------------------------
# where-expression parser
# ---------------------------------------------------------------------------

_TOKEN = re.compile(
    r"\s*(?:(?P<lparen>\()|(?P<rparen>\))|(?P<lbracket>\[)|(?P<rbracket>\])"
    r"|(?P<comma>,)|(?P<string>'(?:[^']|'')*')|(?P<number>-?\d+(?:\.\d+)?)"
    r"|(?P<word>[A-Za-z_][A-Za-z0-9_.]*))"
)


def _tokenize(text: str) -> list[tuple[str, str]]:
    tokens: list[tuple[str, str]] = []
    pos = 0
    while pos < len(text):
        if text[pos].isspace():
            pos += 1
            continue
        match = _TOKEN.match(text, pos)
        if match is None or match.lastgroup is None:
            msg = f"Invalid character in where expression at offset {pos}."
            raise ValueError(msg)
        tokens.append((match.lastgroup, match.group(match.lastgroup)))
        pos = match.end()
    return tokens


class _WhereParser:
    """Recursive-descent parser compiling a where expression to SQL."""

    def __init__(self, text: str, json_columns: frozenset[str], params: _Params) -> None:
        self._tokens = _tokenize(text)
        self._pos = 0
        self._json = json_columns
        self._params = params

    def parse(self) -> sql.Composable:
        node = self._or_expr()
        if self._pos != len(self._tokens):
            msg = "Trailing tokens in where expression."
            raise ValueError(msg)
        return node

    def _peek(self) -> tuple[str, str] | None:
        return self._tokens[self._pos] if self._pos < len(self._tokens) else None

    def _next(self) -> tuple[str, str]:
        token = self._tokens[self._pos]
        self._pos += 1
        return token

    def _is_keyword(self, word: str) -> bool:
        token = self._peek()
        return token is not None and token[0] == "word" and token[1].lower() == word

    def _or_expr(self) -> sql.Composable:
        parts = [self._and_expr()]
        while self._is_keyword("or"):
            self._next()
            parts.append(self._and_expr())
        if len(parts) == 1:
            return parts[0]
        return sql.SQL("({})").format(sql.SQL(" OR ").join(parts))

    def _and_expr(self) -> sql.Composable:
        parts = [self._not_expr()]
        while self._is_keyword("and"):
            self._next()
            parts.append(self._not_expr())
        if len(parts) == 1:
            return parts[0]
        return sql.SQL("({})").format(sql.SQL(" AND ").join(parts))

    def _not_expr(self) -> sql.Composable:
        if self._is_keyword("not"):
            self._next()
            return sql.SQL("NOT ({})").format(self._not_expr())
        return self._atom()

    def _atom(self) -> sql.Composable:
        token = self._peek()
        if token is not None and token[0] == "lparen":
            self._next()
            node = self._or_expr()
            self._expect("rparen")
            return node
        return self._comparison()

    def _comparison(self) -> sql.Composable:
        path = self._expect("word")
        op = self._expect("word").lower()
        if op not in _OPS and op != "in":
            msg = f"Unknown operator {op!r} in where expression."
            raise ValueError(msg)
        col = _column_ref(path, self._json, self._params)
        value = self._value()
        if op == "in":
            return sql.SQL("{} = ANY({})").format(col, self._params.add(list(value)))
        return sql.SQL("{} " + _OPS[op] + " {}").format(col, self._params.add(value))

    def _value(self) -> Any:
        token = self._next()
        kind, text = token
        if kind == "string":
            return text[1:-1].replace("''", "'")
        if kind == "number":
            return float(text) if "." in text else int(text)
        if kind == "lbracket":
            return self._list()
        if kind == "word":
            lowered = text.lower()
            if lowered == "true":
                return True
            if lowered == "false":
                return False
            if lowered == "null":
                return None
        msg = f"Expected a value in where expression, got {text!r}."
        raise ValueError(msg)

    def _list(self) -> list[Any]:
        items: list[Any] = []
        if self._peek() is not None and self._peek()[0] == "rbracket":  # type: ignore[index]
            self._next()
            return items
        items.append(self._value())
        while self._peek() is not None and self._peek()[0] == "comma":  # type: ignore[index]
            self._next()
            items.append(self._value())
        self._expect("rbracket")
        return items

    def _expect(self, kind: str) -> str:
        token = self._peek()
        if token is None or token[0] != kind:
            msg = f"Expected {kind} in where expression."
            raise ValueError(msg)
        self._next()
        return token[1]


def _parse_where(where: str, json_columns: frozenset[str], params: _Params) -> sql.Composable:
    return _WhereParser(where, json_columns, params).parse()


def _select_list(
    select: str | None, json_columns: frozenset[str], params: _Params
) -> sql.Composable:
    if not select:
        return sql.SQL("*")
    items: list[sql.Composable] = []
    for raw in select.split(","):
        path = raw.strip()
        if not path:
            continue
        col = _column_ref(path, json_columns, params)
        if "." in path:
            col = sql.SQL("{} AS {}").format(col, sql.Identifier(path))
        items.append(col)
    return sql.SQL(", ").join(items) if items else sql.SQL("*")


def _order_by(sort: str, json_columns: frozenset[str], params: _Params) -> sql.Composable:
    items: list[sql.Composable] = []
    for raw in sort.split(","):
        token = raw.strip()
        if not token:
            continue
        descending = token.startswith("-")
        path = token[1:] if descending else token
        col = _column_ref(path, json_columns, params)
        items.append(col + (sql.SQL(" DESC") if descending else sql.SQL(" ASC")))
    return sql.SQL(", ").join(items)


def build_list_query(
    *,
    schema: str,
    table: str,
    select: str | None = None,
    where: str | None = None,
    sort: str | None = None,
    limit: int | None = None,
    offset: int | None = None,
    json_columns: Sequence[str] = (),
) -> tuple[sql.Composable, Mapping[str, Any]]:
    """Build a parameterised ``SELECT`` for a list operation."""
    params = _Params()
    json_cols = frozenset(json_columns)
    query = sql.SQL("SELECT {} FROM {}.{}").format(
        _select_list(select, json_cols, params),
        sql.Identifier(schema),
        sql.Identifier(table),
    )
    if where:
        query = query + sql.SQL(" WHERE ") + _parse_where(where, json_cols, params)
    if sort:
        query = query + sql.SQL(" ORDER BY ") + _order_by(sort, json_cols, params)
    if limit is not None:
        query = query + sql.SQL(" LIMIT ") + params.add(int(limit))
    if offset is not None:
        query = query + sql.SQL(" OFFSET ") + params.add(int(offset))
    return query, params.values


def build_get_query(
    *, schema: str, table: str, pk_column: str, pk_value: Any
) -> tuple[sql.Composable, Mapping[str, Any]]:
    """Build a parameterised single-row ``SELECT`` by primary key."""
    params = _Params()
    query = sql.SQL("SELECT * FROM {}.{} WHERE {} = {}").format(
        sql.Identifier(schema),
        sql.Identifier(table),
        sql.Identifier(pk_column),
        params.add(pk_value),
    )
    return query, params.values


def build_delete_query(
    *, schema: str, table: str, pk_column: str, pk_value: Any
) -> tuple[sql.Composable, Mapping[str, Any]]:
    """Build a parameterised ``DELETE`` by primary key."""
    params = _Params()
    query = sql.SQL("DELETE FROM {}.{} WHERE {} = {}").format(
        sql.Identifier(schema),
        sql.Identifier(table),
        sql.Identifier(pk_column),
        params.add(pk_value),
    )
    return query, params.values


def build_replace_query(
    *, schema: str, table: str, pk_column: str, pk_value: Any, data: Mapping[str, Any]
) -> tuple[sql.Composable, Mapping[str, Any]]:
    """Build a parameterised upsert (``INSERT ... ON CONFLICT DO UPDATE``)."""
    params = _Params()
    payload = {**dict(data), pk_column: pk_value}
    columns = list(payload)
    col_ids = sql.SQL(", ").join(sql.Identifier(c) for c in columns)
    values = sql.SQL(", ").join(params.add(_adapt(payload[c])) for c in columns)
    updates = sql.SQL(", ").join(
        sql.SQL("{} = EXCLUDED.{}").format(sql.Identifier(c), sql.Identifier(c))
        for c in columns
        if c != pk_column
    )
    query = sql.SQL(
        "INSERT INTO {}.{} ({}) VALUES ({}) ON CONFLICT ({}) DO UPDATE SET {} RETURNING *"
    ).format(
        sql.Identifier(schema),
        sql.Identifier(table),
        col_ids,
        values,
        sql.Identifier(pk_column),
        updates,
    )
    return query, params.values


def build_merge_patch_query(
    *, schema: str, table: str, pk_column: str, pk_value: Any, patch: Mapping[str, Any]
) -> tuple[sql.Composable, Mapping[str, Any]]:
    """Build a parameterised RFC 7396 merge-patch ``UPDATE`` by primary key."""
    params = _Params()
    assignments = [
        sql.SQL("{} = {}").format(sql.Identifier(key), params.add(_adapt(value)))
        for key, value in patch.items()
    ]
    if not assignments:
        return build_get_query(schema=schema, table=table, pk_column=pk_column, pk_value=pk_value)
    query = sql.SQL("UPDATE {}.{} SET {} WHERE {} = {} RETURNING *").format(
        sql.Identifier(schema),
        sql.Identifier(table),
        sql.SQL(", ").join(assignments),
        sql.Identifier(pk_column),
        params.add(pk_value),
    )
    return query, params.values
